POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-long-random-string
ADMIN_INITIAL_PASSWORD=admin
APP_PORT=5559

# Optional tuning (defaults shown)
#APP_TIMEZONE=America/Chicago
#OCR_LANGS=eng
#AI_BATCH_SIZE=40
#MAX_UPLOAD_BYTES=26214400
#MAX_RESTORE_BYTES=4294967296   # ceiling for an uploaded restore archive
#OCR_TIMEOUT_SECONDS=600

# Production HTTPS (written by install.sh; leave unset for plain HTTP on APP_PORT)
# DOMAIN=finance.example.com
# LETSENCRYPT_EMAIL=you@example.com
# APP_HTTPS_PORT=443
# SESSION_COOKIE_SECURE=1
# COMPOSE_FILE=docker-compose.yml:docker-compose.ssl.yml

# ---- Billing (SaaS mode). Leave every line commented out to run without subscriptions:
#      billing off = every account has full access, exactly as before. ----
# APP_BASE_URL=https://ispend.example.com   # REQUIRED once served over HTTPS (Stripe redirects)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...           # from the Stripe endpoint for /api/billing/webhook
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...             # optional; omit for a monthly-only plan

# ---- Outbound email (welcome, trial reminders, payment failures, password reset).
#      Unset = the app logs a warning and skips the send; nothing breaks. ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls                    # starttls | ssl | none
# SMTP_USER=apikey
# SMTP_PASSWORD=...
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=iSpend

# Hand backup downloads to nginx instead of Flask (needs a world-readable artifact in the
# statements volume; see the Administration section of the README).
# USE_X_ACCEL=1
